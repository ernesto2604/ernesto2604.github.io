/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed but rarely changed: serve from cache for a week, refresh in the background after that.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/models/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/photo/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
